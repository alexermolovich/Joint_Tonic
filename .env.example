# Local web/worker; Auth may use local Supabase or the authorized hosted project.
WORKER_URL=http://127.0.0.1:8765
SIMULATOR_URL=http://127.0.0.1:8766
# Copy into apps/web/.env.local. See docs/supabase-auth.md for hosted Auth.
# For local Auth use public values printed by `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy local CLI anonymous key is also accepted:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
