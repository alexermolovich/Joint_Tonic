# Server-only file at /etc/joint-tonic/worker.env, owner root, mode 0640.
WORKER_SERVICE_TOKEN=
CONTROL_PLANE_URL=https://YOUR_VERCEL_DOMAIN
JOINT_TONIC_RUNTIME_IMAGE=registry.example/joint-tonic-runtime@sha256:REPLACE_WITH_ACTUAL_BUILT_DIGEST
JOINT_TONIC_QUALIFICATION=/opt/joint-tonic/.local/qualification.json
JOINT_TONIC_JOB_TMP=/opt/joint-tonic/.local/runtime-work
